{
  "buildCommand": "cd ../.. && pnpm install --frozen-lockfile && pnpm --filter @kga/admin build",
  "outputDirectory": "dist",
  "installCommand": "echo skip",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://kga-api.onrender.com/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
