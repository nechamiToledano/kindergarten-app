NODE_ENV=development
PORT=3000
# Neon (Frankfurt) — branch per environment (§16)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
JWT_ACCESS_SECRET=change-me-at-least-16-chars
JWT_REFRESH_SECRET=change-me-too-at-least-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CDN_BASE_URL=
# static = assets ship in the build; r2 = upload to Cloudflare R2 (§14.3)
STORAGE_DRIVER=static
# Required only when STORAGE_DRIVER=r2:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://media.example.com
