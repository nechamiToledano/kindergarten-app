NODE_ENV=development
PORT=3000
# Neon (Frankfurt) — branch per environment (§16)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
JWT_ACCESS_SECRET=change-me-at-least-16-chars
JWT_REFRESH_SECRET=change-me-too-at-least-16-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CDN_BASE_URL=
# static = assets ship in the build; r2/b2 = upload to Cloudflare R2 / Backblaze B2,
# served back out through /api/v1/media/file/:key since the bucket stays private (§14.3)
STORAGE_DRIVER=static
# Required only when STORAGE_DRIVER=r2:
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Required only when STORAGE_DRIVER=b2:
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=ganplay-media
B2_REGION=eu-central-003

