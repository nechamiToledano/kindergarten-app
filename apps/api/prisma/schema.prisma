// Kindergarten Screening & Diagnostic App — data model (HLD §9, Spec §3).
// ESM project: Prisma Client generated to a local path, imported explicitly.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEACHER
  KINDERGARTEN_ADMIN
  NETWORK_ADMIN
  CONTENT_EDITOR
}

enum AgeGroup {
  AGE_3_4
  AGE_4_5
  AGE_5_6
}

enum Rating {
  PRESENT
  PARTIALLY_PRESENT
  ABSENT
}

// M7 §3.4 — ASSESSMENT is the diagnostic flow; PRACTICE is the free-play mode.
// Reports filter to ASSESSMENT by default so practice runs never skew statistics.
enum SessionMode {
  ASSESSMENT
  PRACTICE
}

// M10 §2 — an assessment is planned up front, so progress, resumption and
// "what was deliberately skipped" are recorded facts rather than guesses.
enum PlanItemStatus {
  PENDING
  DONE
  SKIPPED
}

enum GameType {
  BINARY_IMAGE_CHOICE
  MULTI_IMAGE_CHOICE
  HOTSPOT_IMAGE
  DRAG_MATCH
  MANUAL_OBSERVATION
  // Added M5 (§17) — 4.5–4.8. Appended in migration order.
  SEQUENTIAL_TAP
  COMPARISON
  PUZZLE
  PATTERN_COPY
}

model Network {
  id            String         @id @default(uuid())
  name          String
  kindergartens Kindergarten[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
}

model Kindergarten {
  id        String    @id @default(uuid())
  name      String
  networkId String?
  network   Network?  @relation(fields: [networkId], references: [id])
  users     User[]
  children  Child[]
  sessions  Session[]
  results   SubdomainResult[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([networkId])
}

model User {
  id             String       @id @default(uuid())
  kindergartenId String?
  kindergarten   Kindergarten? @relation(fields: [kindergartenId], references: [id])
  email          String       @unique
  displayName    String
  passwordHash   String
  role           Role
  refreshTokenHash String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([kindergartenId])
}

model Child {
  id             String       @id @default(uuid())
  kindergartenId String
  kindergarten   Kindergarten @relation(fields: [kindergartenId], references: [id])
  displayName    String
  birthDate      DateTime     @db.Date
  /** M7 §3.2 — uploaded via the existing media pipeline (§14.3), optional. */
  photoUrl       String?
  /** M10 §4 — teacher-set follow-up flag. Drives the dashboard attention panel
      alongside the computed concern rule; never inferred from results alone. */
  watch          Boolean      @default(false)
  sessions       Session[]
  results        SubdomainResult[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([kindergartenId])
}

/**
 * M10 §1 — a developmental area, global across age bands.
 *
 * Replaces `AgeGroupDomain`, which carried an `ageGroup` column and so split one
 * real-world domain into three unrelated rows. That made a child's progression
 * discontinuous the moment they crossed an age band — the exact point the report
 * matters most — and made a kindergarten-wide "phonological awareness" figure
 * impossible. Age is now a property of the *subdomain* (which games apply at
 * which band), not of the domain.
 */
model Domain {
  id          String      @id @default(uuid())
  /** Stable key, independent of the display name. Used by seeds and imports. */
  slug        String      @unique
  name        String
  description String?
  /** lucide icon name, rendered by the shared DomainGlyph component. */
  icon        String?
  orderIndex  Int         @default(0)
  subdomains  Subdomain[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?
}

model Subdomain {
  id                 String             @id @default(uuid())
  domainId           String
  domain             Domain             @relation(fields: [domainId], references: [id])
  name               String
  orderIndex         Int                @default(0)
  /** M10 §1 — the age bands this game is appropriate for. A subdomain that
      applies across the whole kindergarten lists all three. */
  ageGroups          AgeGroup[]
  /** M10 §1 — 1 foundational, 2 developing, 3 advanced. Lets an assessment be
      built at the right difficulty inside an age band, not just per band. */
  level              Int                @default(1)
  teacherInstruction String
  childInstruction   String
  gameType           GameType
  gameConfig         Json
  versions           SubdomainVersion[]
  results            SubdomainResult[]
  planItems          SessionPlanItem[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?

  @@index([domainId])
  @@index([level])
}

// Immutable snapshot a result is measured under (§9.3).
model SubdomainVersion {
  id          String            @id @default(uuid())
  subdomainId String
  subdomain   Subdomain         @relation(fields: [subdomainId], references: [id])
  version     Int
  gameType    GameType
  gameConfig  Json
  results     SubdomainResult[]
  createdAt   DateTime          @default(now())

  @@unique([subdomainId, version])
}

model Session {
  id             String            @id @default(uuid())
  childId        String
  child          Child             @relation(fields: [childId], references: [id])
  kindergartenId String
  kindergarten   Kindergarten      @relation(fields: [kindergartenId], references: [id])
  startedAt      DateTime          @default(now())
  completedAt    DateTime?
  /** M10 §2 — set when a teacher ends a session early. Distinguishes "we stopped"
      from "still open", which the dashboard previously could not tell apart. */
  abandonedAt    DateTime?
  ageGroupAtTime AgeGroup
  mode           SessionMode       @default(ASSESSMENT)
  plan           SessionPlanItem[]
  results        SubdomainResult[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  @@index([kindergartenId])
  @@index([childId])
  // Dashboard and report windows all filter kindergarten + mode + a date range.
  @@index([kindergartenId, mode, startedAt])
}

/**
 * M10 §2 — what this session set out to assess, in order.
 *
 * Before this, a session recorded only what happened to be answered, so the UI
 * could show neither "3 of 12" nor resume an interrupted sitting, and a skipped
 * subdomain was indistinguishable from one never reached.
 */
model SessionPlanItem {
  id          String         @id @default(uuid())
  sessionId   String
  session     Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subdomainId String
  subdomain   Subdomain      @relation(fields: [subdomainId], references: [id])
  orderIndex  Int
  status      PlanItemStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([sessionId, subdomainId])
  @@index([sessionId])
}

model SubdomainResult {
  id                 String           @id @default(uuid())
  // Client-generated idempotency key from the outbox (§11.5).
  clientId           String           @unique
  sessionId          String
  session            Session          @relation(fields: [sessionId], references: [id])
  /**
   * M10 §3 — denormalised from the owning session so this table can be tenant-
   * scoped by the Prisma extension like Child and Session, instead of every
   * report hand-writing `session: { kindergartenId }`. Immutable: a session
   * never changes kindergarten, so this cannot drift from its source.
   */
  kindergartenId     String
  kindergarten       Kindergarten     @relation(fields: [kindergartenId], references: [id])
  /**
   * M10 §3 — also denormalised from the session, and for the same reason: every
   * report asks for "the latest result per child per subdomain". Reaching the
   * child through Session turned that into a join on every single query; here it
   * is one indexed DISTINCT ON. Immutable, like kindergartenId.
   */
  childId            String
  child              Child            @relation(fields: [childId], references: [id])
  subdomainId        String
  subdomain          Subdomain        @relation(fields: [subdomainId], references: [id])
  subdomainVersionId String
  subdomainVersion   SubdomainVersion @relation(fields: [subdomainVersionId], references: [id])
  attemptsCount      Int
  rating             Rating
  teacherNote        String?
  rawAnswers         Json
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([sessionId])
  @@index([subdomainId])
  @@index([kindergartenId])
  // "latest result per child per subdomain" — the shape every report needs.
  @@index([kindergartenId, subdomainId, createdAt])
  @@index([childId, subdomainId, createdAt])
}

/**
 * System-wide, admin-editable configuration (M11 — real management).
 *
 * A row is a named knob a NETWORK_ADMIN can change from the admin app instead of
 * a code deploy. `value` is validated against a per-key Zod schema in
 * `@kga/contracts` before it is written, so this table is structured
 * configuration, not a free-form bucket. Every key that ships has a code-level
 * default, so a missing row is never a broken feature — only "nobody has
 * customised this yet".
 */
model AppSetting {
  key         String    @id
  value       Json
  description String?
  updatedById String?
  updatedAt   DateTime  @updatedAt
  createdAt   DateTime  @default(now())
}

/**
 * The asset library (M11 — real management, §14.3 extended).
 *
 * Every upload through `MediaService.upload` gets one row, storage-backend
 * agnostic (works the same for `StaticAssetStorage` and `R2Storage` — neither
 * needs a "list objects" API). Removing a row only drops it from the library
 * picker; a subdomain's `gameConfig` stores the URL string directly, so an
 * asset already in use is never broken by removing its catalogue entry.
 */
model MediaAsset {
  id           String   @id @default(uuid())
  key          String   @unique
  url          String
  kind         String
  mimeType     String
  sizeBytes    Int
  originalName String?
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([kind, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
