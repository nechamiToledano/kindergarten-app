{
  "name": "kindergarten-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @kga/web dev --host 0.0.0.0",
    "lint": "pnpm --filter @kga/web lint",
    "typecheck": "pnpm --filter @kga/web typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @kga/api prisma:generate",
    "db:migrate": "pnpm --filter @kga/api prisma:migrate",
    "db:seed": "pnpm --filter @kga/api prisma:seed"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.5.0",
    "typescript": "^6.0.2"
  }
}
