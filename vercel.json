{
  "buildCommand": "pnpm turbo run build --filter=@kga/web...",
  "outputDirectory": "apps/web/dist",
  "installCommand": "pnpm install --frozen-lockfile --prod=false",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://kga-api.onrender.com/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
